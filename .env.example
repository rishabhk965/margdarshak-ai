# =============================================================================
# MargDarshak AI - Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your actual values.
# `.env` is gitignored - never commit real secrets.
#
# For production, set these as platform env vars (Railway/Fly/Render),
# NOT by uploading the .env file.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local dev (docker-compose): use the values below as-is
# Production: your hosting platform will inject DATABASE_URL or similar
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/margdarshak
DB_USERNAME=postgres
DB_PASSWORD=postgres


# -----------------------------------------------------------------------------
# AI Provider (choose one: groq | gemini | claude)
# -----------------------------------------------------------------------------
AI_PROVIDER=groq

# Groq (generous free tier on developer accounts — see console.groq.com)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults work for most apps)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# Gemini (free tier: 15 RPM, 1500 req/day) — leave blank if using Groq
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (paid only) — leave blank if using Groq
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# -----------------------------------------------------------------------------
# Where to find these:
# 1. Go to https://developers.facebook.com -> Your App -> WhatsApp -> API Setup
# 2. Copy "Phone number ID" -> WHATSAPP_PHONE_NUMBER_ID
# 3. Copy "Temporary access token" -> WHATSAPP_ACCESS_TOKEN
#    WARNING: temporary tokens expire in 24 hours.
#    For production, create a System User token (never expires):
#    Business Settings -> System Users -> Add -> Generate token with
#    permissions: whatsapp_business_messaging, whatsapp_business_management
# 4. WHATSAPP_VERIFY_TOKEN: any random string YOU choose
#    (used once during webhook setup in Meta portal)

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-to-any-random-string

# Graph API version (matches the curl Meta gives you in API Setup)
WHATSAPP_GRAPH_API_VERSION=v25.0


# -----------------------------------------------------------------------------
# Logging (optional)
# -----------------------------------------------------------------------------
# LOGGING_LEVEL_COM_MARGDARSHAK_AI=DEBUG
